generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  ACTIVE      @map("activo")
  INACTIVE    @map("inactivo")
  VISITOR     @map("visitante")
  TRANSFERRED @map("trasladado")
  DECEASED    @map("fallecido")

  @@map("eme_estado_miembro")
}

enum MemberGender {
  FEMALE      @map("femenino")
  MALE        @map("masculino")
  OTHER       @map("otro")
  UNSPECIFIED @map("sin_especificar")

  @@map("gmi_genero_miembro")
}

enum MemberMaritalStatus {
  SINGLE      @map("soltero")
  MARRIED     @map("casado")
  DIVORCED    @map("divorciado")
  WIDOWED     @map("viudo")
  UNION       @map("union_estable")
  UNSPECIFIED @map("sin_especificar")

  @@map("eci_estado_civil_miembro")
}

enum SystemUserStatus {
  ACTIVE  @map("activo")
  INVITED @map("invitado")
  BLOCKED @map("bloqueado")

  @@map("eus_estado_usuario")
}

enum AccessRecordStatus {
  ACTIVE   @map("activo")
  INACTIVE @map("inactivo")

  @@map("ere_estado_registro")
}

enum MeetingFrequency {
  ONCE     @map("unica")
  DAILY    @map("diaria")
  WEEKLY   @map("semanal")
  BIWEEKLY @map("quincenal")
  MONTHLY  @map("mensual")

  @@map("fre_frecuencia_reunion")
}

/// Modo de cálculo de una recurrencia mensual.
enum MonthlyMode {
  /// Mismo número de día que la fecha ancla; se ajusta al último día en meses cortos.
  FIXED_DAY @map("dia_fijo")
  /// N-ésimo día de semana del mes, por ejemplo el tercer sábado.
  ORDINAL   @map("ordinal")

  @@map("mme_modo_mensual")
}

/// Estado de captura de una fecha concreta en que la reunión debía realizarse.
enum OccurrenceStatus {
  /// La fecha ya pasó y nadie registró asistencia ni ofrenda.
  PENDING  @map("pendiente")
  /// Asistencia y ofrenda capturadas.
  RECORDED @map("registrada")

  @@map("eoc_estado_ocurrencia")
}

model Member {
  id                    Int                   @id(map: "pk_mie_miembro") @default(autoincrement()) @map("mie_id")
  code                  String                @unique(map: "uk_mie_codigo") @map("mie_codigo") @db.VarChar(100)
  firstName             String                @map("mie_primer_nombre") @db.VarChar(100)
  middleName            String?               @map("mie_segundo_nombre") @db.VarChar(100)
  lastName              String                @map("mie_primer_apellido") @db.VarChar(100)
  secondLastName        String?               @map("mie_segundo_apellido") @db.VarChar(100)
  preferredName         String?               @map("mie_nombre_preferido") @db.VarChar(100)
  documentNumber        String?               @unique(map: "uk_mie_numero_documento") @map("mie_numero_documento") @db.VarChar(100)
  birthDate             DateTime?             @map("mie_fecha_nacimiento") @db.Date
  gender                MemberGender          @default(UNSPECIFIED) @map("mie_genero")
  maritalStatus         MemberMaritalStatus   @default(UNSPECIFIED) @map("mie_estado_civil")
  phone                 String?               @map("mie_telefono") @db.VarChar(100)
  alternatePhone        String?               @map("mie_telefono_alterno") @db.VarChar(100)
  email                 String?               @map("mie_correo") @db.VarChar(100)
  address               String?               @map("mie_direccion") @db.VarChar(300)
  municipality          String?               @map("mie_municipio") @db.VarChar(100)
  department            String?               @map("mie_departamento") @db.VarChar(100)
  occupation            String?               @map("mie_ocupacion") @db.VarChar(100)
  status                MemberStatus          @default(ACTIVE) @map("mie_estado")
  joinedAt              DateTime?             @map("mie_fecha_ingreso") @db.Date
  conversionDate        DateTime?             @map("mie_fecha_conversion") @db.Date
  baptismDate           DateTime?             @map("mie_fecha_bautismo") @db.Date
  smallGroup            String?               @map("mie_grupo_pequeno") @db.VarChar(100)
  emergencyContactName  String?               @map("mie_contacto_emergencia") @db.VarChar(100)
  emergencyContactPhone String?               @map("mie_telefono_emergencia") @db.VarChar(100)
  notes                 String?               @map("mie_nota") @db.VarChar(600)
  territorySectorId     Int?                  @map("mie_id_sec")
  createdAt             DateTime              @default(now()) @map("mie_fecha_creacion")
  updatedAt             DateTime              @updatedAt @map("mie_fecha_modificacion")
  user                  User?
  communityRoles        MemberCommunityRole[]
  ministries            MemberMinistry[]
  territorySector       TerritorySector?      @relation("MemberTerritorySector", fields: [territorySectorId], references: [id], onDelete: SetNull, map: "fk_mie_id_sec")
  ledDistricts          District[]            @relation("DistrictLeader")
  ledZones              Zone[]                @relation("ZoneLeader")
  supervisedSectors     TerritorySector[]     @relation("SectorSupervisor")
  ledMeetings           Meeting[]             @relation("MeetingLeader")
  supervisedMeetings    Meeting[]             @relation("MeetingSupervisor")
  ledOccurrences        MeetingOccurrence[]   @relation("OccurrenceLeader")
  coSupervisedMeetings  MeetingCoSupervisor[]

  @@index([status], map: "ix_mie_estado")
  @@index([lastName, firstName], map: "ix_mie_nombre")
  @@index([birthDate], map: "ix_mie_fecha_nacimiento")
  @@index([joinedAt], map: "ix_mie_fecha_ingreso")
  @@index([territorySectorId], map: "ix_mie_sector")
  @@map("mie_miembro")
}

model CommunityRole {
  id          Int                   @id(map: "pk_roc_rol_comunidad") @default(autoincrement()) @map("roc_id")
  code        String                @unique(map: "uk_roc_codigo") @map("roc_codigo") @db.VarChar(100)
  name        String                @unique(map: "uk_roc_nombre") @map("roc_nombre") @db.VarChar(100)
  description String?               @map("roc_descripcion") @db.VarChar(300)
  isActive    Boolean               @default(true) @map("roc_activo")
  isSystem    Boolean               @default(false) @map("roc_sistema")
  createdAt   DateTime              @default(now()) @map("roc_fecha_creacion")
  updatedAt   DateTime              @updatedAt @map("roc_fecha_modificacion")
  members     MemberCommunityRole[]

  @@index([isActive], map: "ix_roc_activo")
  @@map("roc_rol_comunidad")
}

model MemberCommunityRole {
  id        Int           @id(map: "pk_mxr_miembro_rol") @default(autoincrement()) @map("mxr_id")
  memberId  Int           @map("mxr_miembro")
  roleId    Int           @map("mxr_rol")
  startedAt DateTime?     @map("mxr_fecha_inicio") @db.Date
  endedAt   DateTime?     @map("mxr_fecha_fin") @db.Date
  notes     String?       @map("mxr_nota") @db.VarChar(300)
  createdAt DateTime      @default(now()) @map("mxr_fecha_creacion")
  updatedAt DateTime      @updatedAt @map("mxr_fecha_modificacion")
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "fk_mxr_miembro")
  role      CommunityRole @relation(fields: [roleId], references: [id], onDelete: Restrict, map: "fk_mxr_rol")

  @@unique([memberId, roleId], map: "uk_mxr_miembro_rol")
  @@index([roleId], map: "ix_mxr_rol")
  @@map("mxr_miembro_rol")
}

model Ministry {
  id          Int              @id(map: "pk_min_ministerio") @default(autoincrement()) @map("min_id")
  code        String           @unique(map: "uk_min_codigo") @map("min_codigo") @db.VarChar(100)
  name        String           @unique(map: "uk_min_nombre") @map("min_nombre") @db.VarChar(100)
  description String?          @map("min_descripcion") @db.VarChar(300)
  isActive    Boolean          @default(true) @map("min_activo")
  createdAt   DateTime         @default(now()) @map("min_fecha_creacion")
  updatedAt   DateTime         @updatedAt @map("min_fecha_modificacion")
  members     MemberMinistry[]

  @@index([isActive], map: "ix_min_activo")
  @@map("min_ministerio")
}

model MemberMinistry {
  id          Int       @id(map: "pk_mxm_miembro_ministerio") @default(autoincrement()) @map("mxm_id")
  memberId    Int       @map("mxm_miembro")
  ministryId  Int       @map("mxm_ministerio")
  serviceRole String?   @map("mxm_funcion") @db.VarChar(100)
  startedAt   DateTime? @map("mxm_fecha_inicio") @db.Date
  endedAt     DateTime? @map("mxm_fecha_fin") @db.Date
  notes       String?   @map("mxm_nota") @db.VarChar(300)
  createdAt   DateTime  @default(now()) @map("mxm_fecha_creacion")
  updatedAt   DateTime  @updatedAt @map("mxm_fecha_modificacion")
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "fk_mxm_miembro")
  ministry    Ministry  @relation(fields: [ministryId], references: [id], onDelete: Restrict, map: "fk_mxm_ministerio")

  @@unique([memberId, ministryId], map: "uk_mxm_miembro_ministerio")
  @@index([ministryId], map: "ix_mxm_ministerio")
  @@map("mxm_miembro_ministerio")
}

model User {
  id                     Int                 @id(map: "pk_usu_usuario") @default(autoincrement()) @map("usu_id")
  memberId               Int?                @unique(map: "uk_usu_id_mie") @map("usu_id_mie")
  email                  String              @unique(map: "uk_usu_correo") @map("usu_correo") @db.VarChar(100)
  username               String?             @unique(map: "uk_usu_nombre_usuario") @map("usu_nombre_usuario") @db.VarChar(100)
  passwordHash           String              @map("usu_resumen_clave") @db.VarChar(100)
  isActive               Boolean             @default(true) @map("usu_activo")
  status                 SystemUserStatus    @default(ACTIVE) @map("usu_estado")
  twoFactorEnabled       Boolean             @default(false) @map("usu_doble_factor")
  mustChangePassword     Boolean             @default(true) @map("usu_cambiar_clave")
  lastAccessAt           DateTime?           @map("usu_fecha_ultimo_acceso")
  createdAt              DateTime            @default(now()) @map("usu_fecha_creacion")
  updatedAt              DateTime            @updatedAt @map("usu_fecha_modificacion")
  member                 Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull, map: "fk_usu_id_mie")
  authSessions           AuthSession[]
  userRoles              UserRole[]          @relation("UserRoleUser")
  assignedUserRoles      UserRole[]          @relation("UserRoleAssigner")
  grantedRolePermissions RolePermission[]    @relation("RolePermissionGranter")
  recordedOccurrences    MeetingOccurrence[] @relation("OccurrenceRecorder")
  editedOccurrences      MeetingOccurrence[] @relation("OccurrenceEditor")
  receivedInvitations    UserInvitation[]    @relation("UserInvitationRecipient")
  createdInvitations     UserInvitation[]    @relation("UserInvitationCreator")

  @@index([isActive], map: "ix_usu_activo")
  @@index([status], map: "ix_usu_estado")
  @@index([lastAccessAt], map: "ix_usu_fecha_ultimo_acceso")
  @@map("usu_usuario")
}

/// Invitación de acceso de un solo uso enviada a un usuario del sistema.
model UserInvitation {
  /// Identificador interno de la invitación.
  id          Int       @id(map: "pk_inv_invitacion_usuario") @default(autoincrement()) @map("inv_id")
  /// Usuario que debe completar el primer acceso.
  userId      Int       @map("inv_id_usu")
  /// Resumen SHA-256 del token; el token original solo se entrega por correo.
  tokenHash   String    @unique(map: "uk_inv_resumen_token") @map("inv_resumen_token") @db.VarChar(100)
  /// Momento límite para utilizar la invitación.
  expiresAt   DateTime  @map("inv_fecha_expiracion")
  /// Momento en que el token fue consumido correctamente.
  usedAt      DateTime? @map("inv_fecha_uso")
  /// Momento en que una invitación anterior fue invalidada.
  revokedAt   DateTime? @map("inv_fecha_revocacion")
  /// Administrador que creó o reenvió la invitación.
  createdById Int?      @map("inv_id_usu_creador")
  /// Momento en que se generó la invitación.
  createdAt   DateTime  @default(now()) @map("inv_fecha_creacion")
  /// Momento de la última modificación de la invitación.
  updatedAt   DateTime  @updatedAt @map("inv_fecha_modificacion")
  user        User      @relation("UserInvitationRecipient", fields: [userId], references: [id], onDelete: Cascade, map: "fk_inv_id_usu")
  createdBy   User?     @relation("UserInvitationCreator", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_inv_id_usu_creador")

  @@index([userId], map: "ix_inv_usuario")
  @@index([expiresAt], map: "ix_inv_fecha_expiracion")
  @@index([createdById], map: "ix_inv_usuario_creador")
  @@map("inv_invitacion_usuario")
}

model AuthSession {
  id               Int       @id(map: "pk_ses_sesion_autenticacion") @default(autoincrement()) @map("ses_id")
  tokenId          String    @unique(map: "uk_ses_identificador") @default(uuid()) @map("ses_identificador") @db.VarChar(100)
  userId           Int       @map("ses_id_usu")
  refreshTokenHash String    @map("ses_resumen_token_refresco") @db.VarChar(100)
  expiresAt        DateTime  @map("ses_fecha_expiracion")
  revokedAt        DateTime? @map("ses_fecha_revocacion")
  createdAt        DateTime  @default(now()) @map("ses_fecha_creacion")
  updatedAt        DateTime  @updatedAt @map("ses_fecha_modificacion")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_ses_id_usu")

  @@index([userId], map: "ix_ses_usuario")
  @@index([expiresAt], map: "ix_ses_fecha_expiracion")
  @@index([revokedAt], map: "ix_ses_fecha_revocacion")
  @@map("ses_sesion_autenticacion")
}

model Role {
  id              Int                @id(map: "pk_rol_rol") @default(autoincrement()) @map("rol_id")
  name            String             @unique(map: "uk_rol_nombre") @map("rol_nombre") @db.VarChar(100)
  code            String             @unique(map: "uk_rol_codigo") @map("rol_codigo") @db.VarChar(100)
  description     String?            @map("rol_descripcion") @db.VarChar(300)
  isSystem        Boolean            @default(false) @map("rol_sistema")
  status          AccessRecordStatus @default(ACTIVE) @map("rol_estado")
  createdAt       DateTime           @default(now()) @map("rol_fecha_creacion")
  updatedAt       DateTime           @updatedAt @map("rol_fecha_modificacion")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([isSystem], map: "ix_rol_sistema")
  @@index([status], map: "ix_rol_estado")
  @@map("rol_rol")
}

model Permission {
  id              Int                @id(map: "pk_per_permiso") @default(autoincrement()) @map("per_id")
  name            String             @map("per_nombre") @db.VarChar(100)
  code            String             @unique(map: "uk_per_codigo") @map("per_codigo") @db.VarChar(100)
  module          String             @default("General") @map("per_modulo") @db.VarChar(100)
  resource        String             @map("per_recurso") @db.VarChar(100)
  action          String             @map("per_accion") @db.VarChar(100)
  description     String?            @map("per_descripcion") @db.VarChar(300)
  isSystem        Boolean            @default(false) @map("per_sistema")
  status          AccessRecordStatus @default(ACTIVE) @map("per_estado")
  createdAt       DateTime           @default(now()) @map("per_fecha_creacion")
  updatedAt       DateTime           @updatedAt @map("per_fecha_modificacion")
  rolePermissions RolePermission[]

  @@unique([resource, action], map: "uk_per_recurso_accion")
  @@index([module], map: "ix_per_modulo")
  @@index([resource], map: "ix_per_recurso")
  @@index([action], map: "ix_per_accion")
  @@index([status], map: "ix_per_estado")
  @@map("per_permiso")
}

model UserRole {
  id             Int      @id(map: "pk_uxr_usuario_rol") @default(autoincrement()) @map("uxr_id")
  userId         Int      @map("uxr_usuario")
  roleId         Int      @map("uxr_rol")
  assignedAt     DateTime @default(now()) @map("uxr_fecha_asignacion")
  assignedBy     Int?     @map("uxr_id_usu_asignador")
  user           User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade, map: "fk_uxr_usuario")
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "fk_uxr_rol")
  assignedByUser User?    @relation("UserRoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull, map: "fk_uxr_id_usu_asignador")

  @@unique([userId, roleId], map: "uk_uxr_usuario_rol")
  @@index([roleId], map: "ix_uxr_rol")
  @@index([assignedBy], map: "ix_uxr_asignador")
  @@map("uxr_usuario_rol")
}

model RolePermission {
  id            Int        @id(map: "pk_rxp_rol_permiso") @default(autoincrement()) @map("rxp_id")
  roleId        Int        @map("rxp_rol")
  permissionId  Int        @map("rxp_permiso")
  grantedAt     DateTime   @default(now()) @map("rxp_fecha_asignacion")
  grantedBy     Int?       @map("rxp_id_usu_otorgante")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "fk_rxp_rol")
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "fk_rxp_permiso")
  grantedByUser User?      @relation("RolePermissionGranter", fields: [grantedBy], references: [id], onDelete: SetNull, map: "fk_rxp_id_usu_otorgante")

  @@unique([roleId, permissionId], map: "uk_rxp_rol_permiso")
  @@index([permissionId], map: "ix_rxp_permiso")
  @@index([grantedBy], map: "ix_rxp_otorgante")
  @@map("rxp_rol_permiso")
}

model District {
  id          Int      @id(map: "pk_dis_distrito") @default(autoincrement()) @map("dis_id")
  code        String   @unique(map: "uk_dis_codigo") @map("dis_codigo") @db.VarChar(100)
  name        String   @unique(map: "uk_dis_nombre") @map("dis_nombre") @db.VarChar(100)
  description String?  @map("dis_descripcion") @db.VarChar(300)
  leaderName  String?  @map("dis_nombre_lider") @db.VarChar(100)
  leaderId    Int?     @map("dis_id_mie") // TODO: no deberia de ir aqui
  color       String   @map("dis_color") @db.VarChar(100)
  polygon     Json     @map("dis_poligono") @db.JsonB
  isActive    Boolean  @default(true) @map("dis_activo")
  createdAt   DateTime @default(now()) @map("dis_fecha_creacion")
  updatedAt   DateTime @updatedAt @map("dis_fecha_modificacion")
  leader      Member?  @relation("DistrictLeader", fields: [leaderId], references: [id], onDelete: SetNull, map: "fk_dis_id_mie")
  zones       Zone[]

  @@index([leaderId], map: "ix_dis_lider")
  @@index([isActive], map: "ix_dis_activo")
  @@map("dis_distrito")
}

model Zone {
  id          Int               @id(map: "pk_zon_zona") @default(autoincrement()) @map("zon_id")
  districtId  Int               @map("zon_id_dis")
  code        String            @unique(map: "uk_zon_codigo") @map("zon_codigo") @db.VarChar(100)
  name        String            @map("zon_nombre") @db.VarChar(100)
  description String?           @map("zon_descripcion") @db.VarChar(300)
  leaderName  String?           @map("zon_nombre_lider") @db.VarChar(100)
  leaderId    Int?              @map("zon_id_mie") // TODO: no deberia de ir aqui
  color       String            @map("zon_color") @db.VarChar(100)
  polygon     Json              @map("zon_poligono") @db.JsonB
  isActive    Boolean           @default(true) @map("zon_activo")
  createdAt   DateTime          @default(now()) @map("zon_fecha_creacion")
  updatedAt   DateTime          @updatedAt @map("zon_fecha_modificacion")
  district    District          @relation(fields: [districtId], references: [id], onDelete: Cascade, map: "fk_zon_id_dis")
  leader      Member?           @relation("ZoneLeader", fields: [leaderId], references: [id], onDelete: SetNull, map: "fk_zon_id_mie")
  sectors     TerritorySector[]

  @@unique([districtId, name], map: "uk_zon_distrito_nombre")
  @@index([districtId], map: "ix_zon_distrito")
  @@index([leaderId], map: "ix_zon_lider")
  @@index([isActive], map: "ix_zon_activo")
  @@map("zon_zona")
}

model TerritorySector {
  id             Int                 @id(map: "pk_sec_sector") @default(autoincrement()) @map("sec_id")
  zoneId         Int                 @map("sec_id_zon")
  code           String              @unique(map: "uk_sec_codigo") @map("sec_codigo") @db.VarChar(100)
  name           String              @map("sec_nombre") @db.VarChar(100)
  description    String?             @map("sec_descripcion") @db.VarChar(300)
  /// Nombre histórico conservado junto con la relación al catálogo de supervisores.
  supervisorName String?             @map("sec_nombre_supervisor") @db.VarChar(100)
  /// Miembro con rol comunitario SUPERVISOR responsable de las reuniones del sector.
  supervisorId   Int?                @map("sec_id_mie_supervisor")
  color          String              @map("sec_color") @db.VarChar(100)
  polygon        Json                @map("sec_poligono") @db.JsonB
  isActive       Boolean             @default(true) @map("sec_activo")
  createdAt      DateTime            @default(now()) @map("sec_fecha_creacion")
  updatedAt      DateTime            @updatedAt @map("sec_fecha_modificacion")
  zone           Zone                @relation(fields: [zoneId], references: [id], onDelete: Cascade, map: "fk_sec_id_zon")
  supervisor     Member?             @relation("SectorSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull, map: "fk_sec_id_mie_supervisor")
  members        Member[]            @relation("MemberTerritorySector")
  meetings       Meeting[]
  occurrences    MeetingOccurrence[]

  @@unique([zoneId, name], map: "uk_sec_zona_nombre")
  @@index([zoneId], map: "ix_sec_zona")
  @@index([supervisorId], map: "ix_sec_supervisor")
  @@index([isActive], map: "ix_sec_activo")
  @@map("sec_sector")
}

model MeetingType {
  id          Int       @id(map: "pk_tir_tipo_reunion") @default(autoincrement()) @map("tir_id")
  code        String    @unique(map: "uk_tir_codigo") @map("tir_codigo") @db.VarChar(100)
  name        String    @unique(map: "uk_tir_nombre") @map("tir_nombre") @db.VarChar(100)
  description String?   @map("tir_descripcion") @db.VarChar(300)
  color       String    @map("tir_color") @db.VarChar(100)
  isActive    Boolean   @default(true) @map("tir_activo")
  createdAt   DateTime  @default(now()) @map("tir_fecha_creacion")
  updatedAt   DateTime  @updatedAt @map("tir_fecha_modificacion")
  meetings    Meeting[]

  @@index([isActive], map: "ix_tir_activo")
  @@map("tir_tipo_reunion")
}

model Meeting {
  id                Int                   @id(map: "pk_reu_reunion") @default(autoincrement()) @map("reu_id")
  /// Código autogenerado con el formato SECNNN-REUNNNN-AAAAMMDD; se recalcula si
  /// la reunión cambia de sector o de fecha de inicio.
  code              String                @unique(map: "uk_reu_codigo") @map("reu_codigo") @db.VarChar(100)
  typeId            Int                   @map("reu_id_tir")
  sectorId          Int                   @map("reu_id_sec")
  /// Miembro con rol comunitario LEADER responsable de conducir la reunión.
  leaderId          Int                   @map("reu_id_mie_lider")
  supervisorId      Int                   @map("reu_id_mie_supervisor")
  title             String                @map("reu_titulo") @db.VarChar(100)
  description       String?               @map("reu_descripcion") @db.VarChar(300)
  /// Fecha inicial de la reunión y ancla del día para su regla de recurrencia.
  date              DateTime              @map("reu_fecha") @db.Date
  /// Fecha final inclusiva de la recurrencia; null indica que no tiene finalización.
  recurrenceEndDate DateTime?             @map("reu_fecha_fin_recurrencia") @db.Date
  startTime         DateTime              @map("reu_hora_inicio") @db.Time(0)
  endTime           DateTime              @map("reu_hora_fin") @db.Time(0)
  location          String                @map("reu_ubicacion") @db.VarChar(300)
  latitude          Decimal?              @map("reu_latitud") @db.Decimal(10, 7)
  longitude         Decimal?              @map("reu_longitud") @db.Decimal(10, 7)
  frequency         MeetingFrequency      @default(ONCE) @map("reu_frecuencia")
  /// Modo de la recurrencia mensual; nulo para el resto de frecuencias.
  monthlyMode       MonthlyMode?          @map("reu_modo_mensual")
  /// Posición del día dentro del mes (1 a 4, o 5 para el último) en modo ordinal.
  weekOrdinal       Int?                  @map("reu_ordinal_semana") @db.SmallInt
  /// Día de la semana (0 domingo a 6 sábado) en modo ordinal.
  weekday           Int?                  @map("reu_dia_semana") @db.SmallInt
  expectedAttendees Int                   @default(0) @map("reu_asistente_esperado")
  /// Una reunión inactiva deja de generar ocurrencias pendientes.
  isActive          Boolean               @default(true) @map("reu_activa")
  isPublic          Boolean               @default(false) @map("reu_publica")
  notes             String?               @map("reu_nota") @db.VarChar(600)
  color             String                @map("reu_color") @db.VarChar(100)
  createdAt         DateTime              @default(now()) @map("reu_fecha_creacion")
  updatedAt         DateTime              @updatedAt @map("reu_fecha_modificacion")
  type              MeetingType           @relation(fields: [typeId], references: [id], onDelete: Restrict, map: "fk_reu_id_tir")
  sector            TerritorySector       @relation(fields: [sectorId], references: [id], onDelete: Restrict, map: "fk_reu_id_sec")
  leader            Member                @relation("MeetingLeader", fields: [leaderId], references: [id], onDelete: Restrict, map: "fk_reu_id_mie_lider")
  supervisor        Member                @relation("MeetingSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict, map: "fk_reu_id_mie_supervisor")
  coSupervisors     MeetingCoSupervisor[]
  occurrences       MeetingOccurrence[]

  @@index([typeId], map: "ix_reu_tipo")
  @@index([sectorId], map: "ix_reu_sector")
  @@index([leaderId], map: "ix_reu_lider")
  @@index([supervisorId], map: "ix_reu_supervisor")
  @@index([date], map: "ix_reu_fecha")
  @@index([isActive], map: "ix_reu_activa")
  @@map("reu_reunion")
}

model MeetingCoSupervisor {
  id        Int      @id(map: "pk_rxm_reunion_miembro") @default(autoincrement()) @map("rxm_id")
  meetingId Int      @map("rxm_reunion")
  memberId  Int      @map("rxm_miembro")
  createdAt DateTime @default(now()) @map("rxm_fecha_creacion")
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade, map: "fk_rxm_reunion")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Restrict, map: "fk_rxm_miembro")

  @@unique([meetingId, memberId], map: "uk_rxm_reunion_miembro")
  @@index([memberId], map: "ix_rxm_miembro")
  @@map("rxm_reunion_miembro")
}

model OfferingCategory {
  id          Int              @id(map: "pk_cof_categoria_ofrenda") @default(autoincrement()) @map("cof_id")
  code        String           @unique(map: "uk_cof_codigo") @map("cof_codigo") @db.VarChar(100)
  name        String           @unique(map: "uk_cof_nombre") @map("cof_nombre") @db.VarChar(100)
  description String?          @map("cof_descripcion") @db.VarChar(300)
  isActive    Boolean          @default(true) @map("cof_activo")
  sortOrder   Int              @default(0) @map("cof_orden")
  createdAt   DateTime         @default(now()) @map("cof_fecha_creacion")
  updatedAt   DateTime         @updatedAt @map("cof_fecha_modificacion")
  details     OfferingDetail[]

  @@index([isActive], map: "ix_cof_activo")
  @@map("cof_categoria_ofrenda")
}

/// Cada fecha en que una reunión debía realizarse, con su captura de asistencia y ofrenda.
model MeetingOccurrence {
  id                Int                @id(map: "pk_reo_reunion_ocurrencia") @default(autoincrement()) @map("reo_id")
  meetingId         Int                @map("reo_id_reu")
  /// Fecha programada según la regla de recurrencia de la reunión.
  date              DateTime           @map("reo_fecha") @db.Date
  status            OccurrenceStatus   @default(PENDING) @map("reo_estado")
  /// Personas que asistieron; nulo mientras la ocurrencia siga pendiente.
  attendance        Int?               @map("reo_asistencia")
  /// Ofrenda total del día; nulo mientras la ocurrencia siga pendiente.
  totalAmount       Decimal?           @map("reo_monto_total") @db.Decimal(12, 2)
  currency          String             @default("USD") @map("reo_moneda") @db.VarChar(10)
  notes             String?            @map("reo_nota") @db.VarChar(600)
  /// Sector responsable en esa fecha; se conserva aunque la reunión cambie de sector.
  sectorId          Int                @map("reo_id_sec")
  /// Líder responsable en esa fecha; se conserva aunque la reunión cambie de líder.
  leaderId          Int?               @map("reo_id_mie_lider")
  /// Usuario que capturó los datos por primera vez.
  recordedById      Int?               @map("reo_id_usu_registro")
  recordedAt        DateTime?          @map("reo_fecha_registro")
  /// Último usuario que corrigió los datos ya capturados.
  updatedById       Int?               @map("reo_id_usu_modificacion")
  createdAt         DateTime           @default(now()) @map("reo_fecha_creacion")
  updatedAt         DateTime           @updatedAt @map("reo_fecha_modificacion")
  meeting           Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade, map: "fk_reo_id_reu")
  sector            TerritorySector    @relation(fields: [sectorId], references: [id], onDelete: Restrict, map: "fk_reo_id_sec")
  leader            Member?            @relation("OccurrenceLeader", fields: [leaderId], references: [id], onDelete: Restrict, map: "fk_reo_id_mie_lider")
  recordedBy        User?              @relation("OccurrenceRecorder", fields: [recordedById], references: [id], onDelete: SetNull, map: "fk_reo_id_usu_registro")
  updatedBy         User?              @relation("OccurrenceEditor", fields: [updatedById], references: [id], onDelete: SetNull, map: "fk_reo_id_usu_modificacion")
  details           OfferingDetail[]
  attendanceDetails AttendanceDetail[]

  @@unique([meetingId, date], map: "uk_reo_reunion_fecha")
  @@index([status, date], map: "ix_reo_estado_fecha")
  @@index([meetingId], map: "ix_reo_reunion")
  @@index([sectorId], map: "ix_reo_sector")
  @@index([recordedById], map: "ix_reo_usuario_registro")
  @@map("reo_reunion_ocurrencia")
}

/// Catálogo de tipos de asistencia: hermanos, amigos, nuevos, niños, jóvenes.
model AttendanceType {
  id          Int                @id(map: "pk_tas_tipo_asistencia") @default(autoincrement()) @map("tas_id")
  code        String             @unique(map: "uk_tas_codigo") @map("tas_codigo") @db.VarChar(100)
  name        String             @unique(map: "uk_tas_nombre") @map("tas_nombre") @db.VarChar(100)
  description String?            @map("tas_descripcion") @db.VarChar(300)
  isActive    Boolean            @default(true) @map("tas_activo")
  sortOrder   Int                @default(0) @map("tas_orden")
  createdAt   DateTime           @default(now()) @map("tas_fecha_creacion")
  updatedAt   DateTime           @updatedAt @map("tas_fecha_modificacion")
  details     AttendanceDetail[]

  @@index([isActive], map: "ix_tas_activo")
  @@map("tas_tipo_asistencia")
}

/// Cuántas personas de cada tipo asistieron a una fecha concreta.
model AttendanceDetail {
  id           Int               @id(map: "pk_dea_detalle_asistencia") @default(autoincrement()) @map("dea_id")
  occurrenceId Int               @map("dea_id_reo")
  typeId       Int               @map("dea_id_tas")
  quantity     Int               @map("dea_cantidad")
  notes        String?           @map("dea_nota") @db.VarChar(300)
  createdAt    DateTime          @default(now()) @map("dea_fecha_creacion")
  updatedAt    DateTime          @updatedAt @map("dea_fecha_modificacion")
  occurrence   MeetingOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade, map: "fk_dea_id_reo")
  type         AttendanceType    @relation(fields: [typeId], references: [id], onDelete: Restrict, map: "fk_dea_id_tas")

  @@unique([occurrenceId, typeId], map: "uk_dea_ocurrencia_tipo")
  @@index([occurrenceId], map: "ix_dea_ocurrencia")
  @@index([typeId], map: "ix_dea_tipo")
  @@map("dea_detalle_asistencia")
}

model OfferingDetail {
  id           Int               @id(map: "pk_dof_detalle_ofrenda") @default(autoincrement()) @map("dof_id")
  occurrenceId Int               @map("dof_id_reo")
  categoryId   Int               @map("dof_id_cof")
  amount       Decimal           @map("dof_monto") @db.Decimal(12, 2)
  notes        String?           @map("dof_nota") @db.VarChar(300)
  createdAt    DateTime          @default(now()) @map("dof_fecha_creacion")
  updatedAt    DateTime          @updatedAt @map("dof_fecha_modificacion")
  occurrence   MeetingOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade, map: "fk_dof_id_reo")
  category     OfferingCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "fk_dof_id_cof")

  @@unique([occurrenceId, categoryId], map: "uk_dof_ocurrencia_categoria")
  @@index([occurrenceId], map: "ix_dof_ocurrencia")
  @@index([categoryId], map: "ix_dof_categoria")
  @@map("dof_detalle_ofrenda")
}
