# Database (PostgreSQL)
# Runtime connection. Local example:
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/elim_db
# Supabase (serverless/Vercel): transaction pooler, port 6543.
# uselibpqcompat is required — without it the pg driver enforces full certificate
# validation and Supabase's chain fails with "self-signed certificate in chain".
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true

# Connection used only by the Prisma CLI (migrate, diff, studio).
# Leave empty locally; on Supabase point it at the direct connection or the
# session pooler (port 5432). The transaction pooler cannot run DDL.
# DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Empty database used by `prisma migrate dev` / `migrate diff --from-migrations`.
# Must be a local database — never a production one, it gets reset on every run.
# SHADOW_DATABASE_URL=postgresql://postgres:12345678@localhost:5432/elim_shadow

# JWT secret (minimum 32 characters)
JWT_SECRET=replace_this_with_a_long_random_secret_32_chars_min

# App server
PORT=3000
NODE_ENV=development

# Seed administrator. On a remote database these are mandatory and the password
# must be at least 12 characters — the values below are public in this repo.
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin12345!
# Set to true only to deliberately reset an existing admin password: SEED_ADMIN_RESET_PASSWORD=true
# Set to true only to deliberately seed a non-local database: SEED_ALLOW_REMOTE=true

# Public runtime config
NUXT_PUBLIC_APP_NAME=Elim

# Public URL used to build invitation links
APP_BASE_URL=http://127.0.0.1:3000

# SMTP / Mailpit (local defaults)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Elim <no-reply@elim.local>

# Invitation validity (1-168 hours)
USER_INVITATION_TTL_HOURS=24
