# Database (PostgreSQL)
# Local example:
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/elim_db

# JWT secret (minimum 32 characters)
JWT_SECRET=replace_this_with_a_long_random_secret_32_chars_min

# App server
PORT=3000
NODE_ENV=development

# Development seed administrator
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin12345!

# Public runtime config
NUXT_PUBLIC_APP_NAME=Elim

# Public URL used to build invitation links
APP_BASE_URL=http://127.0.0.1:3000

# SMTP / Mailpit (local defaults)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Elim <no-reply@elim.local>

# Invitation validity (1-168 hours)
USER_INVITATION_TTL_HOURS=24
